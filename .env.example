# Copy this file to .env (same directory as docker-compose.yml) and
# fill in real values before running `docker compose up`. .env is
# gitignored — never commit real credentials.

# Postgres credentials used by the postgres and api containers.
POSTGRES_USER=appuser
POSTGRES_PASSWORD=change-me
POSTGRES_DB=phoneme_builder

# Origin the api's CORS headers allow. Must match wherever the
# frontend is actually served from.
FRONTEND_ORIGIN=http://localhost:3000

# Base URL the frontend uses to reach the api, from the browser's
# point of view (so localhost, not the "api" service hostname).
NEXT_PUBLIC_API_URL=http://localhost:4000
